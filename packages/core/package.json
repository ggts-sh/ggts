{
  "name": "@ggts-sh/core",
  "version": "0.43.0",
  "description": "ggts core: framework-agnostic grammar-of-graphics pipeline, scale stability, layout, and the pure SVG-string renderer.",
  "keywords": [
    "canvas",
    "charts",
    "dataviz",
    "ggplot2",
    "grammar-of-graphics",
    "headless",
    "plot",
    "ssr",
    "svg",
    "visualization"
  ],
  "homepage": "https://ggts.sh/",
  "bugs": "https://github.com/ggts-sh/ggts/issues",
  "license": "MIT",
  "author": "Liam O'Dea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggts-sh/ggts.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/render-entry.js",
    "./dist/temporal-entry.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render-entry.d.ts",
      "default": "./dist/render-entry.js"
    },
    "./headless": {
      "types": "./dist/headless-entry.d.ts",
      "default": "./dist/headless-entry.js"
    },
    "./headless/register": {
      "types": "./dist/headless-register-entry.d.ts",
      "default": "./dist/headless-register-entry.js"
    },
    "./temporal": {
      "types": "./dist/temporal-entry.d.ts",
      "default": "./dist/temporal-entry.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./svg-live": {
      "types": "./dist/svg-live/index.d.ts",
      "default": "./dist/svg-live/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./interaction": {
      "types": "./dist/interaction-entry.d.ts",
      "default": "./dist/interaction-entry.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ggts-sh/spec": "^0.43.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
