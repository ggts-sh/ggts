{
  "name": "@ggts-sh/react",
  "version": "0.43.1",
  "description": "ggts React DOM adapter: ggplot2-named components over the framework-agnostic core pipeline.",
  "keywords": [
    "charts",
    "components",
    "dataviz",
    "ggplot2",
    "grammar-of-graphics",
    "react",
    "visualization"
  ],
  "homepage": "https://ggts.sh/",
  "bugs": "https://github.com/ggts-sh/ggts/issues",
  "license": "MIT",
  "author": "Liam O'Dea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggts-sh/ggts.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/host-init.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:ssr": "vitest run --config vitest.ssr.config.ts"
  },
  "dependencies": {
    "@ggts-sh/compose": "^0.43.1",
    "@ggts-sh/core": "^0.43.1",
    "@ggts-sh/spec": "^0.43.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "1.61.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
