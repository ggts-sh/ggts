{
  "name": "@ggts-sh/cli",
  "version": "0.43.0",
  "description": "ggts: validate and render plot specs (JSON) to SVG from the command line — the feedback loop for agents that author charts in sandboxes.",
  "keywords": [
    "agents",
    "charts",
    "cli",
    "dataviz",
    "ggplot2",
    "grammar-of-graphics",
    "headless",
    "plot",
    "svg",
    "validation",
    "visualization"
  ],
  "homepage": "https://ggts.sh/",
  "bugs": "https://github.com/ggts-sh/ggts/issues",
  "license": "MIT",
  "author": "Liam O'Dea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggts-sh/ggts.git",
    "directory": "packages/cli"
  },
  "bin": {
    "ggts": "bin/ggts.js"
  },
  "files": [
    "dist",
    "bin",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ggts-sh/core": "^0.43.0"
  },
  "engines": {
    "node": ">=22"
  }
}
